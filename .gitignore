# Build products
.build/
.builddd/
.build/*
mac/.build/
app/.builddd/
DerivedData/
*.o
*.a
*.ipa

# The engine: a build product of tools/bootstrap.sh, never committed. No trailing slash: bootstrap.sh leaves a
# *symlink* at this path, and `/engine/` only matches a directory.
/engine
/third_party/NX2Apple/
/probe/build/
/probe-out/

# Everything tools/build_zsign.sh produces, and nothing else in app/Signing: the whole folder is a build product
/app/Signing/

# Secrets: a key, a certificate or a provisioning profile must never be added by accident
*.keys
*.p12
*.pfx
*.mobileprovision
prod.keys
*.nxgame

# Xcode and macOS noise
.DS_Store
xcuserdata/
*.xcuserstate
app/Gen/

# Python
__pycache__/
*.pyc
.venv/

# Generated by xcodegen (tools/build_app.sh runs it first)
app/NXPocket.xcodeproj/
