Reason: zsign writes the signing asset's entitlements only into an MH_EXECUTE image: every dylib gets an empty
dict whatever entitlements file it was handed, and no DER entitlements slot in its CodeDirectory (src/archo.cpp,
BuildCodeSignature). Probe test 5C asks whether a framework in Documents loads once its signature carries the app's
own entitlements, and without this it silently re-ran 5A: its log showed "entitlements 181 bytes (none)" for both.
The new flag is off by default, so every existing zsign behaviour is unchanged; tools/zsign_shim.cpp turns it on
only when no entitlements file is given. Applied by tools/build_zsign.sh on top of the pinned revision.

diff --git a/src/archo.cpp b/src/archo.cpp
index 0ce2da0..66cf1c0 100644
--- a/src/archo.cpp
+++ b/src/archo.cpp
@@ -339,8 +339,8 @@ bool ZArchO::BuildCodeSignature(ZSignAsset* pSignAsset,
 
 	string strEmptyEntitlements = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict/>\n</plist>\n";
 	ZSign::SlotBuildRequirements(strBundleId, pSignAsset->m_strSubjectCN, strRequirementsSlot);
-	ZSign::SlotBuildEntitlements(IsExecute() ? pSignAsset->m_strEntitleData : strEmptyEntitlements, strEntitlementsSlot);
-	ZSign::SlotBuildDerEntitlements(IsExecute() ? pSignAsset->m_strEntitleData : "", strDerEntitlementsSlot);
+	ZSign::SlotBuildEntitlements((IsExecute() || pSignAsset->m_bDylibEntitlements) ? pSignAsset->m_strEntitleData : strEmptyEntitlements, strEntitlementsSlot);
+	ZSign::SlotBuildDerEntitlements((IsExecute() || pSignAsset->m_bDylibEntitlements) ? pSignAsset->m_strEntitleData : "", strDerEntitlementsSlot);
 
 	string strRequirementsSlotSHA1;
 	string strRequirementsSlotSHA256;
@@ -419,7 +419,7 @@ bool ZArchO::BuildCodeSignature(ZSignAsset* pSignAsset,
 			strCodeResourcesSHA1,
 			strEntitlementsSlotSHA1,
 			strDerEntitlementsSlotSHA1,
-			IsExecute(),
+			(IsExecute() || pSignAsset->m_bDylibEntitlements),
 			pSignAsset->m_bAdhoc,
 			strCodeDirectorySlot)) {
 			ZLog::Error(">>> Build SHA1 CodeDirectory failed!\n");
@@ -441,7 +441,7 @@ bool ZArchO::BuildCodeSignature(ZSignAsset* pSignAsset,
 		strCodeResourcesSHA256,
 		strEntitlementsSlotSHA256,
 		strDerEntitlementsSlotSHA256,
-		IsExecute(),
+		(IsExecute() || pSignAsset->m_bDylibEntitlements),
 		pSignAsset->m_bAdhoc,
 		strAltnateCodeDirectorySlot)) {
 		ZLog::Error(">>> Build SHA256 CodeDirectory failed!\n");
